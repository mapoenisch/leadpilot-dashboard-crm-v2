      "parameters": {
        "jsCode": "// LeadPilot G46-Nacharbeit (4. Runde): Größenprüfung VOR Dekodierung.\n// Der Webhook läuft mit Raw-Body-Option; n8n legt die Originalbytes als\n// Base64 in binary.data ab. Dieser Node misst nur (Base64-Länge minus Padding,\n// exakt auf 256 KB) und reicht die kodierten Bytes weiter — Dekodierung erst\n// im Folge-Node nach Freigabe. Fehlende Bytes brechen laut ab.\nconst MAX_BODY_BYTES = 256 * 1024;\nconst first = $input.first();\nconst binaryEntry = first.binary && first.binary.data;\nconst base64Body = binaryEntry && binaryEntry.data;\nif (typeof base64Body !== 'string' || base64Body.length === 0) {\n  throw new Error('INGEST_NO_RAW_BODY: Webhook liefert keine Originalbytes (Raw-Body-Option prüfen).');\n}\nconst padding = base64Body.endsWith('==') ? 2 : base64Body.endsWith('=') ? 1 : 0;\nconst decodedBytes = Math.floor(base64Body.length * 3 / 4) - padding;\nif (decodedBytes > MAX_BODY_BYTES) {\n  return [{ json: { valid: false, code: 'INGEST_BODY_TOO_LARGE' } }];\n}\n\nreturn [{\n  json: {\n    rawBase64: base64Body,\n    byteLength: decodedBytes\n  }\n}];"
      },
